[Unit]
Description=ZZIK FastAPI service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zzik
Group=zzik
WorkingDirectory=/opt/zzik/current/backend
EnvironmentFile=/etc/zzik/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/zzik/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
