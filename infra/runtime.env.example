# Copy to /etc/zzik/runtime.env, replace every CHANGE_ME value, then chmod 600.
# Never commit the real runtime.env file.
DATABASE_URL=postgresql+psycopg://zzik:CHANGE_ME@zzik-db.cj24wem202yj.us-east-1.rds.amazonaws.com:5432/zzik
STORAGE_BACKEND=s3
S3_BUCKET=kmuct-ht-01-zzik-photos
AWS_REGION=us-east-1
FACE_PROVIDER=rekognition
VISION_PROVIDER=off
VISION_API_BASE=https://52.79.201.46/v1
VISION_API_KEY=CHANGE_ME
VISION_MODEL_ID=bedrock-haiku
VISION_TIMEOUT_SECONDS=45
# 게이트웨이가 IP 주소용 자체서명 인증서를 쓰면 false 로 둔다. 도메인+정식 인증서면 true.
VISION_VERIFY_TLS=false
WORKER_CONCURRENCY=1
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
