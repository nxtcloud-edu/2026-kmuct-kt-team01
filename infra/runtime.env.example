# Copy to /etc/zzik/runtime.env, replace every CHANGE_ME value, then chmod 600.
# Never commit the real runtime.env file.
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/zzik
STORAGE_BACKEND=s3
S3_BUCKET=kmu-proj-06-zzik
AWS_REGION=us-east-1
FACE_PROVIDER=rekognition
WORKER_CONCURRENCY=1
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
